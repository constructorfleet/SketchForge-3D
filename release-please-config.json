{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "sketchforge",
      "skip-changelog": true,
      "extra-files": [
        {
          "type": "json",
          "path": "packages/sketchforge-engine/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/sketchforge-client/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "packages/sketchforge-client/package.json",
          "jsonpath": "$['dependencies']['@constructorfleet/sketchforge-engine']"
        },
        {
          "type": "toml",
          "path": "packages/sketchforge-py/pyproject.toml",
          "jsonpath": "$.project.version"
        }
      ],
      "include-component-in-tag": false
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "refactor",
      "section": "Internal",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    }
  ]
}
