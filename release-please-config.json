{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "sketchforge",
      "draft": true,
      "skip-changelog": true,
      "extra-files": [
        { "type": "json", "path": "packages/sketchforge-client/package.json", "jsonpath": "$.version" },
        { "type": "toml", "path": "packages/sketchforge-py/pyproject.toml", "jsonpath": "$.project.version" }
      ]
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Internal", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true },
    { "type": "docs", "section": "Documentation", "hidden": true }
  ]
}
