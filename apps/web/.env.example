# No environment variables are required for local development.

# Optional administrator-managed update trigger. Keep these server-side; never
# prefix them with NEXT_PUBLIC_. The trigger must preserve /data/projects.
# SKETCHFORGE_UPDATE_TRIGGER_URL=https://updater.internal/sketchforge
# SKETCHFORGE_UPDATE_ADMIN_KEY=replace-with-a-long-random-key
# SKETCHFORGE_UPDATE_TRIGGER_TOKEN=optional-internal-service-token

# Updating a git checkout from the dashboard needs SKETCHFORGE_UPDATE_ADMIN_KEY
# above, or this opt-in. Set the opt-in only when the server listens on
# loopback alone (for example `next dev -H 127.0.0.1`): the route cannot see the
# caller's address, and any machine that reaches the server can claim localhost.
# SKETCHFORGE_LOCAL_UPDATE=1
