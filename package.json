{
  "name": "sketchforge",
  "version": "1.0.9",
  "private": true,
  "description": "A local-first 3D design editor.",
  "author": {
    "name": "SketchForge contributors"
  },
  "homepage": "https://sketchforge3d.com",
  "desktopName": "sketchforge",
  "main": "apps/desktop/main.cjs",
  "license": "AGPL-3.0-only",
  "scripts": {
    "copy:occt": "node scripts/copy-occt-wasm.mjs",
    "predev": "npm run copy:occt",
    "dev": "next dev apps/web",
    "prebuild": "npm run copy:occt",
    "build": "next build apps/web",
    "export": "node scripts/build-static.mjs",
    "verify:static-worker-assets": "node scripts/verify-static-worker-assets.mjs",
    "start": "next start apps/web",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:watch": "vitest --config tests/vitest.config.ts",
    "test:e2e": "vitest run --config tests/vitest.e2e.config.ts",
    "test:integration": "vitest run --config tests/vitest.integration.config.ts",
    "perf": "vitest run --config tests/vitest.perf.config.ts --reporter verbose",
    "client:build": "tsc -p packages/sketchforge-client/tsconfig.json",
    "client:typecheck": "tsc -p packages/sketchforge-client/tsconfig.tests.json --noEmit",
    "client:test:py": "cd packages/sketchforge-py && PYTHONPATH=src:tests python3 -m unittest discover -s tests -t tests",
    "client:test:py:integration": "cd packages/sketchforge-py && PYTHONPATH=src python3 -m unittest discover -s tests/integration -t tests/integration",
    "ci": "npm run typecheck && npm run typecheck:tests && npm run client:typecheck && npm run test",
    "docker:build": "docker build -f deploy/docker/Dockerfile -t sketchforge:local .",
    "docker:run": "docker run --rm -p 3000:3000 -e SKETCHFORGE_SHARED_PROJECTS_DIR=/data/projects -v sketchforge-shared-projects:/data/projects sketchforge:local",
    "docker:up": "docker compose -f deploy/docker/compose.yaml up --build -d",
    "docker:down": "docker compose -f deploy/docker/compose.yaml down",
    "desktop:dev": "node apps/desktop/dev.mjs",
    "desktop:web:build": "node apps/desktop/build-web.mjs",
    "desktop:pack": "npm run desktop:web:build && electron-builder --dir --config apps/desktop/electron-builder.yml",
    "desktop:dist": "npm run desktop:web:build && electron-builder --config apps/desktop/electron-builder.yml",
    "mcp:sketchforge": "node scripts/sketchforge-mcp-server.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/three": "^0.184.1",
    "@vitest/mocker": "^4.1.12",
    "brepjs": "^18.118.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "lucide-react": "^0.511.0",
    "manifold-3d": "^3.5.0",
    "next": "^15.5.28",
    "occt-wasm": "^3.6.1",
    "react": "^19.1.0",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.8",
    "three": "^0.184.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.13",
    "use-intl": "^4.14.9"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "electron": "^43.8.0",
    "electron-builder": "^26.15.3",
    "js-yaml": "^4.3.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15",
    "brace-expansion": "^1.1.21",
    "fast-uri": "^3.1.8",
    "global-agent": "^4.1.3",
    "http-cache-semantics": "^4.2.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.30",
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "undici": "^6.29.1"
  }
}
